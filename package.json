{
  "name": "pulse-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:maintenance": "vite build --config vite.maintenance.config.js",
    "lint": "eslint .",
    "lint:pulse": "eslint src/auth src/admin scripts/pulse-operator",
    "preview": "vite preview",
    "operator": "node scripts/pulse-operator/cli.js",
    "test:operator": "node --test scripts/pulse-operator/*.test.js",
    "test:auth": "node --test src/auth/*.test.js",
    "test:admin": "node --test src/admin/*.test.js src/admin/api/*.test.js",
    "pulse:check": "npm run lint:pulse && npm run test:auth && npm run test:admin && npm run test:operator && npm run build",
    "pulse:release-check": "npm run pulse:check && git diff --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  }
}
